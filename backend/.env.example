# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/linkforge?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_ACCESS_SECRET=linkforge_super_secret_access_key_2026_change_in_production
JWT_REFRESH_SECRET=linkforge_super_secret_refresh_key_2026_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# SMTP Configuration for Nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=LinkForge <no-reply@linkforge.io>

# Application URLs
FRONTEND_URL=http://localhost:5173
BASE_URL=http://localhost:5000

# Admin Configuration
ADMIN_EMAIL=sparshchauhan050@gmail.com
ADMIN_PASSWORD=your_admin_password
